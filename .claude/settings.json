{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)", "Bash(cargo clippy:*)", "Bash(cargo test:*)", "Bash(cargo build:*)",
      "Bash(cargo check:*)", "Bash(cargo doc:*)", "Bash(cargo deny:*)", "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)", "Bash(scripts/gate:*)", "Bash(scripts/ticket:*)",
      "Bash(scripts/ticket-audit:*)", "Bash(scripts/tests/ticket-audit.test.sh)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git fetch:*)",
      "Bash(git worktree:*)", "Bash(gh issue view:*)", "Bash(gh issue list:*)",
      "Bash(gh pr view:*)", "Bash(gh pr list:*)", "Bash(gh pr diff:*)", "Bash(gh pr checks:*)",
      "Bash(gh run list:*)", "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Read(./.env)", "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rustfmt.sh" }] }
    ]
  }
}
