#!/usr/bin/env bash
# Durable record of in-flight subagents, so a usage-limit stop loses nothing. Requires: jq, flock (gh for list).
#
#   agents check PROMPT_FILE                          run the prompt scans only (do this before dispatching).
#   agents record ROLE REF SHA PROMPT_FILE AGENT_ID   run AFTER the launch: AGENT_ID is the id the launch returned (the
#                                                     SendMessage target for resume). Saves the prompt (mode 0600) and
#                                                     appends a row. REF is `#N` for the implementer (a ticket; never
#                                                     PR-checked) or the PR number for verifiers.
#                                                     Refuses a prompt with a private address (RFC1918, ULA), a
#                                                     scheme://user:pass@ URL, or a value from the secret file.
#                                                     A URL with a port and an at-sign later in its path is also
#                                                     refused as a credential URL (accepted false positive; fails safe).
#   agents done AGENT_ID                              drop the row; keep the prompt as AGENT_ID.prompt.done
#   agents fail AGENT_ID REASON [RESET]               mark the row `limited` with the reset (HH:MM or ISO time)
#   agents list [--pr N]                              print rows. A verifier row whose SHA is no longer its PR head is
#                                                     flagged STALE (relaunch at the new head); UNKNOWN if gh cannot say.
#                                                     --pr N checks only PR N and dies if gh fails.
#
# State: ${WARDENLENS_AGENT_STATE:-$HOME/.local/state/wardenlens/agents}/inflight.tsv (never in the repo).
# Columns (always 9): started_utc role ref sha agent_id status reset prompt_file reason. Status: running | limited.
# `reason` is `-` until `fail` sets it. Secret file: ${WARDENLENS_SECRET_FILE:-$HOME/.config/wardenlens/agentdvr-cameras.secret.json};
# every scalar value (length >= 6) except structural keys (name vendor model active width height codec detector onvif
# port id) is scanned; values are never printed.
set -euo pipefail
export LC_ALL=C
umask 077

state=${WARDENLENS_AGENT_STATE:-$HOME/.local/state/wardenlens/agents}
secret=${WARDENLENS_SECRET_FILE:-$HOME/.config/wardenlens/agentdvr-cameras.secret.json}
tsv=$state/inflight.tsv
incoming=""
trap '[[ -z "$incoming" ]] || rm -f -- "$incoming"' EXIT

die() { echo "agents: $*" >&2; exit 1; }
usage() { awk 'NR >= 2 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; }

valid_id()  { [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$ ]] || die "invalid AGENT_ID '${1:-}'"; }
valid_tok() { [[ "${2:-}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || die "invalid $1 '${2:-}'"; }
valid_ref() { [[ "${1:-}" =~ ^#?[0-9]+$ ]] || die "REF must be N (PR) or #N (ticket): '${1:-}'"; }
valid_sha() { [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]] || die "SHA must be 40 lowercase hex chars: '${1:-}'"; }
clean()     { printf '%s' "$1" | tr '\t\r\n\134' '    ' | cut -c1-200; }
has_id()    { ID=$1 awk -F'\t' '($5 "") == (ENVIRON["ID"] "") { f = 1 } END { exit !f }' "$tsv"; }

init() {
  command -v flock >/dev/null || die "missing dependency: flock"
  mkdir -p "$state"; chmod 700 "$state"
  [[ -f "$tsv" ]] || { : >"$tsv"; }
  chmod 600 "$tsv"
  exec 9>"$state/.lock"; flock 9
}

# grep wrapper: 0 = match, 1 = no match, anything else (bad pattern, I/O error) = refuse.
matches() {
  local rc=0
  grep -a "$@" || rc=$?
  [[ $rc -le 1 ]] || die "refusing: prompt scan failed (grep exit $rc)"
  [[ $rc -eq 0 ]]
}

scan_prompt() {  # FILE: refuse LAN addresses, credentials in URLs and secret-file values; never echo a value
  local f=$1 pats
  # First octet must not follow a digit or `digit.` (keeps version strings like 1.10.20.1.2.3 allowed).
  local pre='(?<![0-9])(?<![0-9]\.)'
  # Also catches CIDR (10.N/16, 192.168/16) and wildcard/placeholder tails (.x .X .*).
  local rfc1918="(10\\.[0-9]{1,3}|172\\.(1[6-9]|2[0-9]|3[01])|192\\.168)(\\.[0-9xX*]|/[0-9])"
  if matches -q -P -- "$pre$rfc1918" "$f"; then
    die "refusing: prompt contains a private (RFC1918) address"
  fi
  if matches -q -P -i -- '(?<![0-9a-z])f[cd][0-9a-f]{2}:' "$f"; then
    die "refusing: prompt contains a private (ULA) IPv6 address"
  fi
  if matches -q -P -- '[A-Za-z][A-Za-z0-9+.-]*://[^/\s@:]*:\S*@' "$f"; then
    die "refusing: prompt contains a scheme://user:pass@ credential"
  fi
  [[ -f "$secret" ]] || return 0
  command -v jq >/dev/null || die "missing dependency: jq"
  pats=$(jq -r '
    def vals: if type == "object" then
                to_entries[]
                | if (.key | IN("name","vendor","model","active","width","height","codec","detector","onvif","port","id"))
                     and (.value | type | IN("object","array") | not) then empty else .value | vals end
              elif type == "array" then .[] | vals
              elif type == "null" or type == "boolean" then empty
              else tostring | split("\n")[] end;
    [vals | select(length >= 6)] | unique[]' "$secret") \
    || die "cannot read the secret file (failing closed)"
  if [[ -n "$pats" ]] && matches -q -F -f <(printf '%s\n' "$pats") -- "$f"; then
    die "refusing: prompt contains a value from the secret file"
  fi
}

# The one validation both `check` and `record` apply to a prompt file.
vet_prompt() {
  [[ -f "$1" && ! -L "$1" ]] || die "prompt file not found (or a symlink): $1"
  [[ $(stat -c %s -- "$1") -le 1048576 ]] || die "prompt file larger than 1 MiB"
  scan_prompt "$1"
}

cmd_check() {
  [[ $# -eq 1 ]] || die "usage: check PROMPT_FILE"
  vet_prompt "$1"
}

cmd_record() {
  [[ $# -eq 5 ]] || die "usage: record ROLE REF SHA PROMPT_FILE AGENT_ID"
  local role=$1 ref=$2 sha=$3 pf=$4 id=$5
  valid_tok ROLE "$role"; valid_ref "$ref"; valid_sha "$sha"; valid_id "$id"
  vet_prompt "$pf"
  init
  if has_id "$id"; then die "AGENT_ID already recorded: $id"; fi
  incoming=$state/.incoming.$$
  cat -- "$pf" >"$incoming"; chmod 600 "$incoming"
  vet_prompt "$incoming"
  mv -- "$incoming" "$state/$id.prompt"; incoming=""
  printf '%s\t%s\t%s\t%s\t%s\trunning\t-\t%s\t-\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$role" "$ref" "$sha" "$id" "$state/$id.prompt" >>"$tsv"
}

cmd_done() {
  [[ $# -eq 1 ]] || die "usage: done AGENT_ID"
  valid_id "$1"; init
  has_id "$1" || die "unknown AGENT_ID: $1"
  ID=$1 awk -F'\t' '($5 "") != (ENVIRON["ID"] "")' "$tsv" >"$tsv.new" && mv -- "$tsv.new" "$tsv"
  chmod 600 "$tsv"
  if [[ -f "$state/$1.prompt" ]]; then
    local dest=$state/$1.prompt.done
    [[ ! -e "$dest" ]] || dest=$dest.$(date -u +%Y%m%dT%H%M%SZ).$$
    mv -- "$state/$1.prompt" "$dest"
  fi
}

cmd_fail() {
  [[ $# -ge 2 && $# -le 3 ]] || die "usage: fail AGENT_ID REASON [RESET]"
  valid_id "$1"; init
  has_id "$1" || die "unknown AGENT_ID: $1"
  local reason reset
  reason=$(clean "$2" | tr -d '\n' | tr -c 'A-Za-z0-9_.:-' '_' | cut -c1-40); reason=${reason:-"-"}
  reset=${3:--}
  if [[ ! "$reset" =~ ^([0-9]{1,2}:[0-9]{2}|[0-9TZ:+-]{10,25}|-)$ ]]; then
    echo "agents: ignoring malformed RESET (stored as -)" >&2; reset=-
  fi
  ID=$1 R=$reset WHY=$reason awk -F'\t' -v OFS='\t' \
    '($5 "") == (ENVIRON["ID"] "") { $6 = "limited"; $7 = ENVIRON["R"]; $9 = ENVIRON["WHY"] } { print }' \
    "$tsv" >"$tsv.new" && mv -- "$tsv.new" "$tsv"
  chmod 600 "$tsv"
}

cmd_list() {
  local pr=""
  if [[ "${1:-}" == "--pr" ]]; then
    [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--pr needs a number"
    pr=$2
  elif [[ $# -gt 0 ]]; then die "usage: list [--pr N]"; fi
  [[ -s "$tsv" ]] || { echo "no inflight agents"; return 0; }
  local -A heads=()
  local ts role ref sha id st reset pf reason flag h
  if [[ -n "$pr" ]]; then
    h=$(timeout 30 gh pr view "$pr" --json headRefOid -q .headRefOid </dev/null) || die "cannot read PR #$pr"
    valid_sha "$h"; heads[$pr]=$h
  fi
  while IFS=$'\t' read -r ts role ref sha id st reset pf reason <&3; do
    flag=""
    if [[ "$ref" =~ ^[0-9]+$ && ( -z "$pr" || "$ref" == "$pr" ) ]]; then
      if [[ -z "${heads[$ref]+x}" ]]; then
        h=""
        if command -v gh >/dev/null; then h=$(timeout 30 gh pr view "$ref" --json headRefOid -q .headRefOid </dev/null 2>/dev/null) || h=""; fi
        [[ "$h" =~ ^[0-9a-f]{40}$ ]] || h="-"
        heads[$ref]=$h
      fi
      h=${heads[$ref]}
      if [[ "$h" == "-" ]]; then flag="UNKNOWN (cannot read PR head)"
      elif [[ "$sha" != "$h" ]]; then flag="STALE (head is now ${h:0:12})"; fi
    fi
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$ts" "$role" "$ref" "${sha:0:12}" "$id" "$st" "$reset" "$pf" "$reason" "$flag"
  done 3<"$tsv"
}

case "${1:-}" in
  check)  shift; cmd_check "$@" ;;
  record) shift; cmd_record "$@" ;;
  done)   shift; cmd_done "$@" ;;
  fail)   shift; cmd_fail "$@" ;;
  list)   shift; cmd_list "$@" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
