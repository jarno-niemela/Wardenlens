#!/usr/bin/env bash
# ARCH-7 check: fail if a camera id from a site list kept OUTSIDE the repo occurs in non-test code, scripts, spike
# scripts, compose.yaml or docker/. The list is never committed and never read from a fixed location: point
# WARDENLENS_SITE_IDS_FILE at it (one id per line; blank lines and # comments ignored). Unset: skipped with a notice.
# Usage: scripts/site-id-check [root]   (root defaults to the repository top level)
# An id matches only as a whole token (not inside a longer [A-Za-z0-9_-] run), so `tapo-c110` is not `tapo`.
# Rust files named tests.rs / under tests/ directories are excluded; the check never prints the list.
set -euo pipefail
root="${1:-$(git rev-parse --show-toplevel)}"
list="${WARDENLENS_SITE_IDS_FILE:-}"
if [[ -z $list ]]; then
  echo "site-id-check: WARDENLENS_SITE_IDS_FILE is not set; skipped (ARCH-7 reviewer checklist still applies)"
  exit 0
fi
[[ -f $list && -r $list ]] || { echo "site-id-check: WARDENLENS_SITE_IDS_FILE is not a readable file" >&2; exit 2; }
cd "$root"
targets=()
for p in crates/*/src scripts spikes compose.yaml docker; do [[ -e $p ]] && targets+=("$p"); done
found=0
while IFS= read -r id; do
  id="${id%$'\r'}"
  [[ -z $id || $id == \#* ]] && continue
  # The id is quoted literally (\Q..\E); an id containing \E is refused rather than interpreted.
  [[ $id == *'\E'* ]] && { echo "site-id-check: unusable id in the list" >&2; exit 2; }
  if grep -rnIP --exclude=tests.rs --exclude-dir=tests --exclude-dir=target --exclude-dir=results --exclude=site-id-check \
      -e "(?<![A-Za-z0-9_-])\\Q${id}\\E(?![A-Za-z0-9_-])" -- "${targets[@]}" >/dev/null; then
    # Report where, not the id.
    grep -rlIP --exclude=tests.rs --exclude-dir=tests --exclude-dir=target --exclude-dir=results --exclude=site-id-check \
      -e "(?<![A-Za-z0-9_-])\\Q${id}\\E(?![A-Za-z0-9_-])" -- "${targets[@]}" | sed 's/^/site-id-check: a site camera id occurs in /' >&2
    found=1
  fi
done <"$list"
if (( found )); then echo "site-id-check: FAILED (ARCH-7: no site camera ids outside tests)" >&2; exit 1; fi
echo "site-id-check: ok"
