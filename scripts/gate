#!/usr/bin/env bash
# Local quality gate — the same checks CI runs. Must pass before a PR is opened.
# Usage: scripts/gate [--quick]   (--quick skips doc + deny)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
quick=0; [[ "${1:-}" == "--quick" ]] && quick=1
if [[ "${GITHUB_ACTIONS:-}" != true && "$(git config core.hooksPath || true)" != .githooks ]]; then
  echo "gate: core.hooksPath must be .githooks (run: git config core.hooksPath .githooks); the pre-push hook is the authoritative push control" >&2
  exit 1
fi
step() { printf '\n== %s\n' "$*"; }
# shellcheck source=scripts/lib/vault.sh disable=SC1091  # CI runs shellcheck without -x; scripts/gate checks vault.sh with -x
. scripts/lib/vault.sh

step "fmt";    cargo fmt --all -- --check
step "clippy"; cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
step "test";   cargo test --workspace --all-features --locked
# ADR 0006 section 9: the tree's own build scans the tracked tree. Skipped (said so) only with no vault; a
# vault that exists is always scanned, in CI too.
step "vault scan"
vault_scan_tree cargo run -q -p wardenlens-cli --locked -- || exit 1
step "tooling tests"
for t in scripts/tests/*.test.sh scripts/tests/adversarial/*.sh; do "$t" >/dev/null || { echo "FAILED: $t" >&2; "$t" | grep -v '^ok' >&2 || true; exit 1; }; done
# Spike shell tests that need only stubs and a temporary HOME (never the real vault or a camera). Each runs under a
# scrubbed environment and unsets the same variables itself. Gate-only until CI runs them (CI is locked; owner follow-up).
spike_env=(env -u WARDENLENS_BIN -u WARDENLENS_VAULT -u WARDENLENS_VAULT_KEY_FILE -u WARDENLENS_VAULT_KEY -u CAMERAS -u XDG_CONFIG_HOME -u XDG_DATA_HOME -u BASH_ENV -u ENV)
while read -r v; do spike_env+=(-u "$v"); done < <(compgen -e | grep '^ONVIF_' || true)
for t in lib.adv.sh lib-r2.adv.sh cams-r1.adv.sh cams-r2.adv.sh cams-r3.adv.sh cams-r4.adv.sh pullpoint.test.sh; do
  "${spike_env[@]}" "spikes/s1-cameras/tests/$t" >/dev/null || {
    echo "FAILED: spikes/s1-cameras/tests/$t" >&2; "${spike_env[@]}" "spikes/s1-cameras/tests/$t" | grep -v '^ok' >&2 || true; exit 1; }
done
if command -v shellcheck >/dev/null; then
  step "shellcheck"
  shellcheck -x scripts/agents scripts/ticket scripts/ticket-audit scripts/verify scripts/gate scripts/labels.sh \
    scripts/lib/vault.sh scripts/hooks-staged/pre-* scripts/tests/*.sh scripts/tests/adversarial/*.sh \
    spikes/s1-cameras/lib.sh spikes/s1-cameras/tests/*.sh .claude/hooks/*.sh .githooks/*
fi
if [[ $quick -eq 0 ]]; then
  step "doc";  RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --all-features --locked
  if command -v cargo-deny >/dev/null; then step "deny"; cargo deny check
  else echo "(cargo-deny not installed; skipped locally — CI enforces it. Install: cargo install --locked cargo-deny)"; fi
fi
printf '\ngate: PASS\n'
