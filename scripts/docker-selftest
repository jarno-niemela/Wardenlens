#!/usr/bin/env bash
# Manual check of the container runtime assumptions (#69, ADR 0005 section 11). Needs Docker and network access for the
# first build; it is not part of scripts/gate. It builds the `selftest` image target and runs the wardenlens-fsutil test
# executables inside it, under the container runtime's default seccomp profile (so `openat2` and `renameat2` are proved
# allowed, `RootDir` refusing `..` and symlinks and RENAME_NOREPLACE are exercised) on a bind-mounted directory standing
# in for the archive filesystem. Uses synthetic temporary data only.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
kernel=$(uname -r)
echo "host kernel: $kernel (openat2 needs 5.6 or later)"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
docker build -q -f docker/Dockerfile --target selftest -t wardenlens-selftest:local . >/dev/null
trap 'rm -rf "$tmp"; docker image rm -f wardenlens-selftest:local >/dev/null 2>&1 || true' EXIT
status=0
for exe in $(docker run --rm --entrypoint /bin/ls wardenlens-selftest:local /selftest); do
  # The tests create their files under TMPDIR: the bind mount, a real host filesystem.
  if docker run --rm --user "$(id -u):$(id -g)" -e TMPDIR=/mnt/fs -v "$tmp:/mnt/fs" \
      --entrypoint "/selftest/$exe" wardenlens-selftest:local --quiet >"$tmp/out" 2>&1; then
    echo "ok   $exe"
  else
    echo "FAIL $exe"; tail -n 20 "$tmp/out"; status=1
  fi
done
exit $status
