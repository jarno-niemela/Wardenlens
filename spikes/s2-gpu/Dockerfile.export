# One-off ONNX export of YOLOv8/YOLO11 (CPU torch). Ultralytics is AGPL-3.0: used only to produce benchmark models here.
FROM python:3.12-slim
RUN pip install --no-cache-dir torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir ultralytics==8.3.50 onnx onnxslim onnxruntime onnxscript
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /models
ENTRYPOINT []
