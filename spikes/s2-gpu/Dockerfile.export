# One-off ONNX export of YOLOv8/YOLO11 (CPU-only: the container has no GPU access). Ultralytics is AGPL-3.0: used only to produce benchmark models here.
# NOTE: installing ultralytics replaces the torch pin below (final torch is 2.15.0); results/pip-freeze-export.txt is the authoritative list.
FROM python:3.12.16-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
RUN pip install --no-cache-dir torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir ultralytics==8.3.50 onnx onnxslim onnxruntime onnxscript
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /models
ENTRYPOINT []
