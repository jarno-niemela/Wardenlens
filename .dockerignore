# Backstop for the Docker build context (#69). The Dockerfile copies only Cargo.*, rust-toolchain.toml and
# crates/, so everything else is excluded anyway; these entries keep a stray secret out of the context.
target/
**/target/
spikes/
.git
.github/
.claude/
.githooks/
cameras/
docs/
scripts/
# Secrets and local overrides (ADR 0006 section 6: a compose secret source lives outside the work tree).
/secrets/
*.key
*.secret*
*.local.*
.env
.env.*
**/*.rs.bk
*.profraw
