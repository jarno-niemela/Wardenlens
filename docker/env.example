# Copy to `.env` next to compose.yaml (`.env` is git-ignored) and edit. Names only; no secret belongs in this file.
# The key file itself stays outside the work tree and outside backups (docs/deploy.md).

# Host address the API port is published on. Never 0.0.0.0 unless you mean every interface. Default 127.0.0.1.
WARDENLENS_LAN_ADDR=192.168.1.10
WARDENLENS_API_PORT=8080

# Host paths (absolute).
WARDENLENS_HOT_HOST=/srv/wardenlens/recordings
WARDENLENS_ARCHIVE_HOST=/srv/wardenlens/archive
WARDENLENS_STATE_HOST=/srv/wardenlens/state
WARDENLENS_CONFIG_HOST=/etc/wardenlens/wardenlens.toml
WARDENLENS_KEY_FILE_HOST=/etc/wardenlens/key/vault.key

# The uid and gid the service runs as. The image's fixed user is 10001; the key file, the state directory and the
# recording directories must belong to the uid you set here.
WARDENLENS_UID=10001
WARDENLENS_GID=10001
