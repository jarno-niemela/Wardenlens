#!/usr/bin/env bash
# Fast local checks before each commit. Enable with: git config core.hooksPath .githooks
set -euo pipefail
# shellcheck source=/dev/null
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
cargo fmt --all -- --check || { echo "pre-commit: run 'cargo fmt --all'" >&2; exit 1; }
cargo clippy --workspace --all-targets --locked --quiet -- -D warnings
