#!/usr/bin/env bash
# Authoritative push control. Git runs this before every push with the remote name and URL as $1 and
# $2 (unused) and one line per ref update on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# It sees the real updates, whatever the command line looked like (refspecs, config, aliases, wrappers).
#
# Refused:
#   - any update of refs/heads/main or refs/heads/master (open a PR instead)
#   - any update or deletion of an EXISTING remote tag (refs/tags/*), even with WARDENLENS_ALLOW_REWRITE=1;
#     creating a new tag is allowed
#   - any deletion (deleting remote branches requires the user)
#   - a remote sha not present locally (unknown remote state; fetch first)
#   - a non-fast-forward update (force push)
#   - commits that change any file under .github/workflows/ (workflows are privileged: a PR could
#     redefine the CI check). The commits examined are those reachable from local_sha but not from
#     remote_sha or any remote-tracking ref (so merging/pulling main that already carries a human
#     workflow change is fine). Merge commits are judged by their combined diff: a path counts only
#     when the merge result differs from every parent (an evil merge), not when it takes one side.
#     A merge must also keep every workflow change a parent brought in since their merge base, so
#     `merge -s ours origin/main` (or restoring "our" side) cannot silently revert a change on main.
# Exceptions (human-only; the Bash guard denies agents setting either name):
#   - a non-fast-forward update of a refs/heads/* branch other than main/master is allowed when
#     WARDENLENS_ALLOW_REWRITE=1, because `--force-with-lease` on your own feature branch is legitimate
#     and a pre-push hook cannot tell it from `--force`.
#   - a push that changes .github/workflows/ is allowed when WARDENLENS_ALLOW_WORKFLOWS=1.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

is_zero() { [[ "$1" =~ ^0+$ ]]; }
refuse() { echo "pre-push: refused: $1 ($2)" >&2; exit 1; }

# workflow_files LSHA RSHA: print the paths under .github/workflows/ touched by the pushed commits
workflow_files() {
  local lsha=$1 rsha=$2 base=()
  if ! is_zero "$rsha"; then base=("$rsha"); fi
  git log --full-history --diff-merges=combined --no-renames --format= --name-only \
    "$lsha" --not "${base[@]}" --remotes -- ':(top).github/workflows'
  local m b par
  local -a parents
  while read -r m; do
    mapfile -t parents < <(git rev-parse "$m^@")
    b=$(git merge-base --octopus "${parents[@]}") || b=4b825dc642cb6eb9a060e54bf8d69288fbee4904
    for par in "${parents[@]}"; do
      comm -12 <(git diff --no-renames --name-only "$b" "$par" -- ':(top).github/workflows' | sort) \
               <(git diff --no-renames --name-only "$par" "$m" -- ':(top).github/workflows' | sort)
    done
  done < <(git rev-list --merges "$lsha" --not "${base[@]}" --remotes)
}

while read -r lref lsha rref rsha; do
  case "$rref" in
    refs/heads/main|refs/heads/master) refuse "never push to main; open a PR" "$lref -> $rref" ;;
  esac
  case "$rref" in
    refs/tags/*) if ! is_zero "$rsha"; then refuse "existing tags are immutable (no update or deletion, forward or rewrite)" "$rref"; fi ;;
  esac
  if is_zero "$lsha"; then refuse "deleting remote branches requires the user" "$rref"; fi
  if ! is_zero "$rsha"; then
    git cat-file -e "$rsha^{commit}" 2>/dev/null || refuse "unknown remote state; fetch first" "$rref at $rsha"
    if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
      if [[ "${WARDENLENS_ALLOW_REWRITE:-}" == 1 && "$rref" == refs/heads/* ]]; then
        echo "pre-push: WARNING: rewriting $rref (WARDENLENS_ALLOW_REWRITE=1)" >&2
      else
        refuse "non-fast-forward / force push" "$rref"
      fi
    fi
  fi
  wf=$(workflow_files "$lsha" "$rsha" 2>/dev/null) || refuse "cannot inspect the pushed commits for workflow changes" "$rref"
  if [[ -n "$wf" ]]; then
    if [[ "${WARDENLENS_ALLOW_WORKFLOWS:-}" == 1 ]]; then
      echo "pre-push: WARNING: pushing changes to .github/workflows/ (WARDENLENS_ALLOW_WORKFLOWS=1)" >&2
    else
      refuse "changes to .github/workflows/ need the user (WARDENLENS_ALLOW_WORKFLOWS=1, human only)" "$rref: $(head -n1 <<<"$wf")"
    fi
  fi
done
exit 0
